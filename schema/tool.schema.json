{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashachar/algogens-library-data/schema/tool.schema.json",
  "title": "AlgoGens Library tool",
  "description": "An open-source library, tool or loop you can install today that pairs a generative model with an algorithmic check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "author",
    "kind",
    "repo_url",
    "install",
    "one_liner",
    "loop",
    "not_proved",
    "license",
    "sources",
    "checked_on"
  ],
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "library",
        "tool",
        "loop"
      ]
    },
    "repo_url": {
      "type": "string",
      "pattern": "^https://"
    },
    "install": {
      "type": "string",
      "minLength": 1
    },
    "one_liner": {
      "type": "string",
      "minLength": 1
    },
    "loop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proposes",
        "judged_by",
        "steers"
      ],
      "properties": {
        "proposes": {
          "type": "string",
          "minLength": 1
        },
        "judged_by": {
          "type": "string",
          "minLength": 1
        },
        "steers": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "not_proved": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          }
        }
      }
    },
    "checked_on": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
